<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_APDS01" targetNamespace="http://hadron.eu.com/bpmn/hfb_transfer_order_febelco" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collab_APDS01" name="APDS - przebieg">
    <bpmn:participant id="Part_Alias" name="Serwer ALIAS (HTTP / SFTP)">
    </bpmn:participant>
    <bpmn:participant id="Part_Odoo" name="Odoo 19 - hfb_apds" processRef="Process_APDS01">
    </bpmn:participant>
    <bpmn:messageFlow id="Msg" name="Plik JSON" sourceRef="Part_Alias" targetRef="T_E1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_APDS01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_APDS01">
      <bpmn:lane id="Lane_Init" name="Cron inicjowania">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Create</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Work" name="Cron worker 1..5">
        <bpmn:flowNodeRef>G_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Partners</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Uruchomienie crona (1 dzień)">
      <bpmn:outgoing>Flow_Start_T_Create</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Start" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Create" name="Utwórz przebieg [download / pending]">
      <bpmn:documentation>_cron_apds_init: dla każdej aktywnej konfiguracji z providerem</bpmn:documentation>
      <bpmn:incoming>Flow_Start_T_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Create_G_Delay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Delay" name="Odstęp od ostatniego przebiegu minął?" default="Flow_G_Delay_Tm">
      <bpmn:incoming>Flow_T_Create_G_Delay</bpmn:incoming>
      <bpmn:incoming>Flow_Tm_G_Delay</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Delay_T_E1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Delay_Tm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Tm" name="Kolejne wywołanie (1 min)">
      <bpmn:incoming>Flow_G_Delay_Tm</bpmn:incoming>
      <bpmn:outgoing>Flow_Tm_G_Delay</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Tm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_E1" name="Etap 1 Pobierz plik [download]">
      <bpmn:documentation>_apds_stage_download</bpmn:documentation>
      <bpmn:incoming>Flow_G_Delay_T_E1</bpmn:incoming>
      <bpmn:outgoing>Flow_T_E1_T_E2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_E2" name="Etap 2 Mapuj rekordy do stagingu [prepare]">
      <bpmn:documentation>_apds_stage_prepare</bpmn:documentation>
      <bpmn:incoming>Flow_T_E1_T_E2</bpmn:incoming>
      <bpmn:outgoing>Flow_T_E2_G_Type</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Type" name="Rodzaj importu?" default="Flow_G_Type_G_Join">
      <bpmn:incoming>Flow_T_E2_G_Type</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Type_T_Partners</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Type_G_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Partners" name="Utwórz brakujących partnerów (ref = kod)">
      <bpmn:documentation>_apds_ensure_supplier_partners</bpmn:documentation>
      <bpmn:incoming>Flow_G_Type_T_Partners</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Partners_G_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Join" name="">
      <bpmn:incoming>Flow_G_Type_G_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T_Partners_G_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Join_Sub</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub" name="Etap 3 - dla każdej partii">
      <bpmn:incoming>Flow_G_Join_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_T_Fin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="S_Start" name="">
        <bpmn:outgoing>Flow_S_Start_S_T</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="S_T" name="Przetwórz partię [process]">
        <bpmn:documentation>_apds_stage_process</bpmn:documentation>
        <bpmn:incoming>Flow_S_Start_S_T</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_S_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="S_End" name="">
        <bpmn:incoming>Flow_S_T_S_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S_Start_S_T" sourceRef="S_Start" targetRef="S_T" />
      <bpmn:sequenceFlow id="Flow_S_T_S_End" sourceRef="S_T" targetRef="S_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_Err" name="Błąd" attachedToRef="Sub">
      <bpmn:outgoing>Flow_B_Err_E_Err</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_B_Err" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E_Err" name="apds_result = error">
      <bpmn:incoming>Flow_B_Err_E_Err</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Fin" name="Finalizacja: raport, usunięcie stagingu [received / manual]">
      <bpmn:documentation>_apds_try_finalize_stage3</bpmn:documentation>
      <bpmn:incoming>Flow_Sub_T_Fin</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Fin_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Koniec przebiegu">
      <bpmn:incoming>Flow_T_Fin_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_T_Create" sourceRef="Start" targetRef="T_Create" />
    <bpmn:sequenceFlow id="Flow_T_Create_G_Delay" sourceRef="T_Create" targetRef="G_Delay" />
    <bpmn:sequenceFlow id="Flow_G_Delay_T_E1" name="tak" sourceRef="G_Delay" targetRef="T_E1" />
    <bpmn:sequenceFlow id="Flow_G_Delay_Tm" name="nie" sourceRef="G_Delay" targetRef="Tm" />
    <bpmn:sequenceFlow id="Flow_Tm_G_Delay" sourceRef="Tm" targetRef="G_Delay" />
    <bpmn:sequenceFlow id="Flow_T_E1_T_E2" sourceRef="T_E1" targetRef="T_E2" />
    <bpmn:sequenceFlow id="Flow_T_E2_G_Type" sourceRef="T_E2" targetRef="G_Type" />
    <bpmn:sequenceFlow id="Flow_G_Type_T_Partners" name="supplier_ids" sourceRef="G_Type" targetRef="T_Partners" />
    <bpmn:sequenceFlow id="Flow_G_Type_G_Join" name="products" sourceRef="G_Type" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_T_Partners_G_Join" sourceRef="T_Partners" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_G_Join_Sub" sourceRef="G_Join" targetRef="Sub" />
    <bpmn:sequenceFlow id="Flow_Sub_T_Fin" sourceRef="Sub" targetRef="T_Fin" />
    <bpmn:sequenceFlow id="Flow_T_Fin_End" sourceRef="T_Fin" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_B_Err_E_Err" sourceRef="B_Err" targetRef="E_Err" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_APDS01">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_APDS01" bpmnElement="Collab_APDS01">
      <bpmndi:BPMNShape id="Part_Alias_di" bpmnElement="Part_Alias" isHorizontal="true">
        <dc:Bounds x="160" y="20" width="1700" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Odoo_di" bpmnElement="Part_Odoo" isHorizontal="true">
        <dc:Bounds x="160" y="110" width="1700" height="470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Init_di" bpmnElement="Lane_Init" isHorizontal="true">
        <dc:Bounds x="190" y="110" width="1670" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Work_di" bpmnElement="Lane_Work" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="1670" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true">
        <dc:Bounds x="1310" y="340" width="260" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="252" y="167" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Create_di" bpmnElement="T_Create">
        <dc:Bounds x="320" y="140" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Delay_di" bpmnElement="G_Delay" isMarkerVisible="true">
        <dc:Bounds x="495" y="385" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="392" y="355" width="100" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tm_di" bpmnElement="Tm">
        <dc:Bounds x="502" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="560" y="520" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_E1_di" bpmnElement="T_E1">
        <dc:Bounds x="610" y="365" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_E2_di" bpmnElement="T_E2">
        <dc:Bounds x="770" y="365" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Type_di" bpmnElement="G_Type" isMarkerVisible="true">
        <dc:Bounds x="945" y="385" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="940" y="455" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Partners_di" bpmnElement="T_Partners">
        <dc:Bounds x="1050" y="275" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Join_di" bpmnElement="G_Join" isMarkerVisible="true">
        <dc:Bounds x="1215" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_di" bpmnElement="S_Start">
        <dc:Bounds x="1327" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_di" bpmnElement="S_T">
        <dc:Bounds x="1380" y="365" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_di" bpmnElement="S_End">
        <dc:Bounds x="1512" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Err_di" bpmnElement="B_Err">
        <dc:Bounds x="1332" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Err_di" bpmnElement="E_Err">
        <dc:Bounds x="1402" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Fin_di" bpmnElement="T_Fin">
        <dc:Bounds x="1600" y="365" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1772" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_T_Create_di" bpmnElement="Flow_Start_T_Create">
        <di:waypoint x="288" y="185" />
        <di:waypoint x="320" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_Create_G_Delay_di" bpmnElement="Flow_T_Create_G_Delay">
        <di:waypoint x="380" y="230" />
        <di:waypoint x="380" y="410" />
        <di:waypoint x="495" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G_Delay_T_E1_di" bpmnElement="Flow_G_Delay_T_E1">
        <di:waypoint x="545" y="410" />
        <di:waypoint x="610" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G_Delay_Tm_di" bpmnElement="Flow_G_Delay_Tm">
        <di:waypoint x="520" y="435" />
        <di:waypoint x="520" y="512" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Tm_G_Delay_di" bpmnElement="Flow_Tm_G_Delay">
        <di:waypoint x="502" y="530" />
        <di:waypoint x="440" y="530" />
        <di:waypoint x="440" y="410" />
        <di:waypoint x="495" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_E1_T_E2_di" bpmnElement="Flow_T_E1_T_E2">
        <di:waypoint x="730" y="410" />
        <di:waypoint x="770" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_E2_G_Type_di" bpmnElement="Flow_T_E2_G_Type">
        <di:waypoint x="890" y="410" />
        <di:waypoint x="945" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G_Type_T_Partners_di" bpmnElement="Flow_G_Type_T_Partners">
        <di:waypoint x="970" y="385" />
        <di:waypoint x="970" y="320" />
        <di:waypoint x="1050" y="320" />
        <bpmndi:BPMNLabel><dc:Bounds x="978" y="300" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G_Type_G_Join_di" bpmnElement="Flow_G_Type_G_Join">
        <di:waypoint x="995" y="410" />
        <di:waypoint x="1215" y="410" />
        <bpmndi:BPMNLabel><dc:Bounds x="1060" y="415" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_Partners_G_Join_di" bpmnElement="Flow_T_Partners_G_Join">
        <di:waypoint x="1170" y="320" />
        <di:waypoint x="1240" y="320" />
        <di:waypoint x="1240" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G_Join_Sub_di" bpmnElement="Flow_G_Join_Sub">
        <di:waypoint x="1265" y="410" />
        <di:waypoint x="1310" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sub_T_Fin_di" bpmnElement="Flow_Sub_T_Fin">
        <di:waypoint x="1570" y="410" />
        <di:waypoint x="1600" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_Fin_End_di" bpmnElement="Flow_T_Fin_End">
        <di:waypoint x="1720" y="410" />
        <di:waypoint x="1772" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_Start_S_T_di" bpmnElement="Flow_S_Start_S_T">
        <di:waypoint x="1363" y="410" />
        <di:waypoint x="1380" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S_T_S_End_di" bpmnElement="Flow_S_T_S_End">
        <di:waypoint x="1500" y="410" />
        <di:waypoint x="1512" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_Err_E_Err_di" bpmnElement="Flow_B_Err_E_Err">
        <di:waypoint x="1350" y="530" />
        <di:waypoint x="1402" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_di" bpmnElement="Msg">
        <di:waypoint x="670" y="80" />
        <di:waypoint x="670" y="365" />
        <bpmndi:BPMNLabel><dc:Bounds x="678" y="150" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
