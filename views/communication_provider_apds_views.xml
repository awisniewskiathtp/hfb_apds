<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_communication_provider_apds_form" model="ir.ui.view">
        <field name="name">communication.provider.apds.form</field>
        <field name="model">communication.provider.apds</field>
        <field name="arch" type="xml">
			<form string="Konfiguracja APDS">
				<sheet>
					<group>
						<group>
							<field name="name"/>
							<field name="code"/>
							<field name="active"/>
							<field name="company_id"/>
							<field name="apds_download_protocol"/>
						</group>
						<group string="Kanał SFTP" invisible="apds_download_protocol != 'sftp'">
							<field name="sftp_host"/>
							<field name="sftp_port"/>
							<field name="sftp_username"/>
							<field name="sftp_password" password="True"/>
							<field name="sftp_private_key"/>
							<field name="sftp_remote_path"/>
						</group>
						<group string="Kanał HTTP" invisible="apds_download_protocol != 'http'">
							<field name="http_url"/>
						</group>
					</group>
					<group string="Pliki źródłowe">
						<field name="apds_batch_size"/>
						<field name="local_staging_dir"/>
						<field name="apds_cleanup_source_file"/>
					</group>
				</sheet>
			</form>
        </field>
    </record>

    <record id="view_communication_provider_apds_list" model="ir.ui.view">
        <field name="name">communication.provider.apds.list</field>
        <field name="model">communication.provider.apds</field>
        <field name="arch" type="xml">
            <list string="Konfiguracje APDS">
                <field name="name"/>
                <field name="code"/>
                <field name="sftp_host"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_communication_provider_apds" model="ir.actions.act_window">
        <field name="name">Konfiguracje APDS</field>
        <field name="res_model">communication.provider.apds</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
