<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="ir_cron_apds_init" model="ir.cron">
		<field name="name">APDS - inicjowanie przebiegu</field>
		<field name="model_id"
			   ref="hfb_apds.model_communication_provider_apds"/>
		<field name="state">code</field>
		<field name="code">model._cron_apds_init()</field>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="active" eval="False"/>
	</record>

	<record id="ir_cron_apds_process" model="ir.cron">
		<field name="name">APDS - przetwarzanie przebiegów</field>
		<field name="model_id"
			   ref="hfb_apds.model_communication_log"/>
		<field name="state">code</field>
		<field name="code">model._cron_apds_process()</field>
		<field name="interval_number">1</field>
		<field name="interval_type">minutes</field>
		<field name="active" eval="False"/>
	</record>

</odoo>
